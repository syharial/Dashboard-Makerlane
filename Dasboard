<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Makerlane Campaign Dashboard</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;700;900&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        maker: {
                            dark: '#020502',
                            light: '#FFFFFF',
                            green: '#80E893',
                            border: '#1A1D1A',
                            surface: '#0a0d0a'
                        }
                    },
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background-color: #020502;
            color: #FFFFFF;
            font-family: 'Inter', sans-serif;
            margin: 0;
            overflow: hidden; /* Prevent full body scroll, handle in panes */
        }
        
        /* Custom scrollbar for a sleek look */
        .custom-scrollbar::-webkit-scrollbar { width: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #1A1D1A; border-radius: 10px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #80E893; }

        .wireframe-shadow {
            box-shadow: 0 20px 40px -10px rgba(0,0,0,0.8), 0 0 20px rgba(128,232,147,0.1);
        }
    </style>
</head>
<body class="flex flex-col md:flex-row h-screen w-full selection:bg-maker-green selection:text-maker-dark">

    <!-- LEFT PANE (40%): Timeline / Content List -->
    <div class="order-2 md:order-1 w-full md:w-[40%] h-[50vh] md:h-screen overflow-y-auto border-t md:border-t-0 md:border-r border-maker-border bg-maker-dark custom-scrollbar p-6">
        
        <header class="mb-10 mt-4">
            <h1 class="text-2xl font-black mb-2 leading-tight">
                Campaign <span class="text-maker-green">Makerlane</span>
            </h1>
            <p class="text-sm text-gray-400">26 Okt - 20 Nov 2026 &bull; Interactive Brief</p>
        </header>

        <div id="timeline-container" class="flex flex-col gap-8">
            <!-- Timeline will be injected here via JS -->
        </div>
        <div class="pb-12"></div>
    </div>

    <!-- RIGHT PANE (60%): Sticky Preview Area -->
    <div class="order-1 md:order-2 w-full md:w-[60%] h-[50vh] md:h-screen flex flex-col bg-maker-surface relative overflow-y-auto custom-scrollbar">
        <!-- Background Glow -->
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[300px] h-[300px] bg-maker-green opacity-[0.03] blur-[120px] pointer-events-none z-0"></div>
        
        <div class="flex-1 flex flex-col items-center justify-center p-6 md:p-12 z-10 min-h-full">
            
            <!-- Dynamic Render Area -->
            <div id="preview-render" class="w-full max-w-[900px] flex flex-col items-center gap-8 transition-opacity duration-300">
                <!-- Rendered Wireframe goes here -->
            </div>

            <!-- Brief Description Area -->
            <div id="brief-render" class="w-full max-w-[400px] mt-8 bg-[#111411] border border-maker-border rounded-xl p-5 shadow-lg">
                <!-- Rendered Brief goes here -->
            </div>

        </div>
    </div>

    <script>
        // Data Campaign
        const campaignData = [
            { week: "Minggu 1: Kenalan", items: [
                { id: "w1-1", date: "26 Okt", title: "Feed #1: Teaser", format: "Feed 4:5", template: "Template B", desc: "Margin aman 80px, font Inter, hijau #80E893 untuk hook. Gunakan pendaran (glow) halus di latar." },
                { id: "w1-2", date: "27 Okt", title: "Story - Kreator", format: "Story 9:16", template: "Story 1", desc: "Margin aman atas bawah untuk UI IG. Tambahkan stiker link 'Amankan Slot' di bawah teks." },
                { id: "w1-3", date: "28 Okt", title: "Feed #2: Ajakan Gabung", format: "Feed 4:5", template: "Template A", desc: "Gunakan foto stok kreator/setup PC, beri gradasi gelap pekat di bagian bawah agar teks kontras." },
                { id: "w1-4", date: "29 Okt", title: "Story - Klien", format: "Story 9:16", template: "Story 2", desc: "Satu hook warna hijau per kanvas. Tambahkan stiker link 'Cari Kreator'." },
                { id: "w1-5", date: "30 Okt", title: "Feed #3: Value Utama", format: "Feed 4:5", template: "Template A", desc: "Teks maksimal 3 baris. Foto yang merepresentasikan efisiensi waktu / klien UMKM." }
            ]},
            { week: "Minggu 2: Edukasi", items: [
                { id: "w2-1", date: "2 Nov", title: "Feed #4: Kesalahan Clipper", format: "Feed 4:5 (Carousel)", template: "Template C", desc: "Carousel hitam polos. Slide pertama berfokus pada tipografi bold, slide berikutnya untuk poin edukasi." },
                { id: "w2-2", date: "3 Nov", title: "Story - Umum", format: "Story 9:16", template: "Story 3", desc: "Desain awareness umum, tautkan stiker ke link Discord komunitas Makerlane." },
                { id: "w2-3", date: "4 Nov", title: "Feed #5: Cara Pilih Kreator", format: "Feed 4:5 (Carousel)", template: "Template C", desc: "Gunakan layout serupa Feed #4, pastikan setiap slide hanya punya 1 elemen hook hijau." },
                { id: "w2-4", date: "6 Nov", title: "Feed #6: Sorotan Streamer", format: "Feed 4:5", template: "Template D", desc: "Foto streamer digelapkan dengan overlay agar kutipan putih panjang tetap dominan di tengah." }
            ]},
            { week: "Minggu 3: Cara Kerja", items: [
                { id: "w3-1", date: "9 Nov", title: "Feed #7: Alur Campaign", format: "Feed 4:5 (Carousel)", template: "Template C", desc: "Jelaskan alur pendaftaran untuk klien. Pertahankan latar gelap solid di setiap slide." },
                { id: "w3-2", date: "11 Nov", title: "Feed #8: Alur Kerja", format: "Feed 4:5 (Carousel)", template: "Template C", desc: "Fokus ke kreator. SOP verifikasi dibuat ringkas, maksimal 25 kata per slide." },
                { id: "w3-3", date: "13 Nov", title: "Feed #9: Sorotan Streamer", format: "Feed 4:5", template: "Template D", desc: "Sorotan tokoh streamer kedua. Kutipan diletakkan tepat di tengah (center-aligned)." }
            ]},
            { week: "Minggu 4: Bukti & Ajakan", items: [
                { id: "w4-1", date: "16 Nov", title: "Feed #10: Hasil Nyata", format: "Feed 4:5", template: "Template A", desc: "Social proof / testimoni kreator. Gunakan foto nyata jika ada, gradasi hitam bawah wajib." },
                { id: "w4-2", date: "18 Nov", title: "Feed #11: Top Up Gratis", format: "Feed 4:5", template: "Template B", desc: "Tipografi tebal, hard-selling. Pastikan kontras teks putih dan hijau sangat jelas (Glow halus di belakang)." },
                { id: "w4-3", date: "20 Nov", title: "Feed #12: Recap & CTA", format: "Feed 4:5 (Carousel)", template: "Template C", desc: "Slide penutup kampanye 1 bulan. Rangkum fitur terbaik dan dorong pendaftaran terakhir." }
            ]}
        ];

        // Wireframe Generators (Pure CSS/HTML)
        const wireframes = {
            "Template A": () => `
                <div class="w-[280px] md:w-[320px] aspect-[4/5] bg-[#1a1d1a] relative overflow-hidden rounded-sm wireframe-shadow border border-gray-800">
                    <div class="absolute inset-0 bg-gray-800 flex items-center justify-center"><span class="text-gray-600 font-bold tracking-widest text-sm">[FOTO STOK]</span></div>
                    <div class="absolute inset-x-0 bottom-0 h-[60%] bg-gradient-to-t from-[#020502] via-[#020502]/80 to-transparent"></div>
                    <div class="absolute top-6 left-6 text-white font-bold text-sm tracking-wide">Makerlane</div>
                    <div class="absolute bottom-8 left-6 right-6 flex flex-col">
                        <span class="text-white font-black text-3xl leading-tight">Karyamu</span>
                        <span class="text-maker-green font-black text-3xl leading-tight">Layak Dibayar</span>
                        <span class="text-gray-300 text-sm mt-3 font-medium">Daftar sekarang</span>
                    </div>
                </div>
            `,
            "Template B": () => `
                <div class="w-[280px] md:w-[320px] aspect-[4/5] bg-[#020502] relative flex flex-col justify-center p-6 overflow-hidden rounded-sm wireframe-shadow border border-gray-800">
                    <div class="absolute top-6 left-6 text-white font-bold text-sm tracking-wide z-10">Makerlane</div>
                    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-48 h-48 bg-maker-green rounded-full blur-[70px] opacity-[0.25] pointer-events-none z-0"></div>
                    <div class="relative z-10 flex flex-col items-start px-2">
                        <span class="text-white font-black text-[40px] leading-[0.9] tracking-tight">GRATIS</span>
                        <span class="text-maker-green font-black text-[40px] leading-[0.9] tracking-tight">TOP UP</span>
                        <span class="text-white font-black text-[40px] leading-[0.9] tracking-tight">DI MAKERLANE</span>
                    </div>
                </div>
            `,
            "Template C": () => `
                <div class="w-full max-w-[900px] flex flex-col items-center">
                    <div class="flex items-center gap-3 mb-6">
                        <span class="animate-pulse w-2 h-2 rounded-full bg-maker-green"></span>
                        <p class="text-xs text-gray-400 font-bold tracking-widest uppercase">Geser untuk melihat Carousel</p>
                    </div>
                    <div class="flex gap-6 overflow-x-auto pb-6 w-full snap-x snap-mandatory custom-scrollbar px-4" style="scroll-snap-type: x mandatory;">
                        
                        <!-- Slide 1: Cover Hook -->
                        <div class="flex-none w-[280px] md:w-[320px] aspect-[4/5] bg-[#020502] relative flex flex-col justify-center p-6 overflow-hidden rounded-sm wireframe-shadow border border-gray-800 snap-center">
                            <div class="absolute top-6 left-6 text-white font-bold text-sm tracking-wide">Makerlane</div>
                            <div class="flex flex-col items-start px-2">
                                <span class="text-white font-black text-3xl leading-[1] tracking-tight">3 KESALAHAN</span>
                                <span class="text-maker-green font-black text-5xl leading-[1] tracking-tight mb-2">CLIPPER</span>
                                <span class="text-gray-400 text-sm mt-4 font-medium flex items-center gap-2">Swipe &rarr;</span>
                            </div>
                        </div>

                        <!-- Slide 2: Slide Isi Bernomor -->
                        <div class="flex-none w-[280px] md:w-[320px] aspect-[4/5] bg-[#020502] relative flex flex-col justify-start p-8 overflow-hidden rounded-sm wireframe-shadow border border-gray-800 snap-center">
                            <div class="absolute top-6 left-6 text-gray-600 font-black text-xl tracking-wide">01</div>
                            <div class="mt-12 flex flex-col items-start">
                                <span class="text-maker-green font-black text-3xl leading-tight mb-4">Tidak Pakai<br>Kontrak</span>
                                <p class="text-gray-300 text-sm leading-relaxed font-medium">
                                    Pastikan selalu ada kesepakatan tertulis sebelum mulai mengedit. (Maksimal 25 kata per slide sesuai guideline teks).
                                </p>
                            </div>
                        </div>

                        <!-- Slide 3: Slide CTA -->
                        <div class="flex-none w-[280px] md:w-[320px] aspect-[4/5] bg-[#020502] relative flex flex-col items-center justify-center p-6 text-center overflow-hidden rounded-sm wireframe-shadow border border-gray-800 snap-center">
                            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-48 h-48 bg-maker-green rounded-full blur-[80px] opacity-[0.15] pointer-events-none z-0"></div>
                            <div class="relative z-10 w-full flex flex-col items-center">
                                <div class="text-white font-black text-2xl leading-tight tracking-tight mb-6">Siap dibayar<br>secara profesional?</div>
                                <div class="bg-maker-green text-maker-dark px-6 py-3 rounded-full font-bold text-sm shadow-[0_0_15px_rgba(128,232,147,0.4)] cursor-pointer hover:bg-white hover:text-black transition-colors duration-200">Daftar Kreator Sekarang</div>
                            </div>
                        </div>

                    </div>
                </div>
            `,
            "Template D": () => `
                <div class="w-[280px] md:w-[320px] aspect-[4/5] bg-gray-900 relative flex flex-col items-center justify-center p-8 text-center overflow-hidden rounded-sm wireframe-shadow border border-gray-800">
                    <div class="absolute inset-0 bg-black/60 pointer-events-none z-0"></div>
                    <div class="absolute top-6 left-6 text-white font-bold text-sm tracking-wide z-10">Makerlane</div>
                    <div class="relative z-10 text-white font-black text-4xl leading-tight tracking-tight">
                        Tempat<br>terbaik<br>untuk<br>kreator
                    </div>
                    <div class="absolute bottom-8 left-0 right-0 text-center z-10">
                        <span class="text-maker-green font-bold text-xl">Streamer Indonesia</span>
                    </div>
                </div>
            `,
            "Story 1": () => `
                <div class="h-[450px] md:h-[500px] aspect-[9/16] bg-[#020502] relative flex flex-col items-center justify-center text-center p-6 overflow-hidden rounded-lg wireframe-shadow border border-gray-800">
                    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-40 h-40 bg-maker-green rounded-full blur-[80px] opacity-30 pointer-events-none z-0"></div>
                    <div class="absolute top-8 text-white font-bold text-sm tracking-wide z-10">Makerlane</div>
                    <div class="relative z-10 w-full">
                        <div class="text-white font-black text-3xl leading-tight tracking-tight">KARYAMU LAYAK</div>
                        <div class="text-maker-green font-black text-3xl leading-tight tracking-tight mt-1">DIBAYAR PENUH</div>
                        <p class="text-gray-300 text-sm mt-6 font-medium">Alur proyek jelas, tanpa drama.</p>
                    </div>
                    <div class="absolute bottom-16 bg-white text-black px-4 py-2 rounded-full font-bold text-xs shadow-lg z-10">🔗 Amankan Slot</div>
                </div>
            `,
            "Story 2": () => `
                <div class="h-[450px] md:h-[500px] aspect-[9/16] bg-[#020502] relative flex flex-col items-center justify-center text-center p-6 overflow-hidden rounded-lg wireframe-shadow border border-gray-800">
                    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-40 h-40 bg-maker-green rounded-full blur-[80px] opacity-30 pointer-events-none z-0"></div>
                    <div class="absolute top-8 text-white font-bold text-sm tracking-wide z-10">Makerlane</div>
                    <div class="relative z-10 w-full">
                        <div class="text-white font-black text-3xl leading-tight tracking-tight">BIKIN KONTEN</div>
                        <div class="text-maker-green font-black text-3xl leading-tight tracking-tight mt-1">BEBAS RIBET</div>
                        <p class="text-gray-300 text-sm mt-6 font-medium">Top up tanpa potongan biaya.</p>
                    </div>
                    <div class="absolute bottom-16 bg-white text-black px-4 py-2 rounded-full font-bold text-xs shadow-lg z-10">🔗 Cari Kreator</div>
                </div>
            `,
            "Story 3": () => `
                <div class="h-[450px] md:h-[500px] aspect-[9/16] bg-[#020502] relative flex flex-col items-center justify-center text-center p-6 overflow-hidden rounded-lg wireframe-shadow border border-gray-800">
                    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-40 h-40 bg-maker-green rounded-full blur-[80px] opacity-30 pointer-events-none z-0"></div>
                    <div class="absolute top-8 text-white font-bold text-sm tracking-wide z-10">Makerlane</div>
                    <div class="relative z-10 w-full">
                        <div class="text-white font-black text-3xl leading-tight tracking-tight">DUKUNG STREAMER</div>
                        <div class="text-maker-green font-black text-3xl leading-tight tracking-tight mt-1">DUKUNG KARYA</div>
                        <p class="text-gray-300 text-sm mt-6 font-medium px-4">Tempat kreator dan brand bertemu.</p>
                    </div>
                    <div class="absolute bottom-16 bg-white text-black px-4 py-2 rounded-full font-bold text-xs shadow-lg z-10">🔗 Join Komunitas</div>
                </div>
            `
        };

        let currentlyActiveId = null;

        function initDashboard() {
            const container = document.getElementById('timeline-container');
            
            campaignData.forEach((weekData, weekIndex) => {
                // Week Header
                const weekHeader = document.createElement('h2');
                weekHeader.className = "text-maker-green font-bold uppercase tracking-wider text-sm mb-3 mt-4 border-b border-maker-border pb-2";
                weekHeader.innerText = weekData.week;
                container.appendChild(weekHeader);

                // Week Items
                const list = document.createElement('ul');
                list.className = "flex flex-col gap-2";

                weekData.items.forEach((item) => {
                    const li = document.createElement('li');
                    li.className = "group relative cursor-pointer";
                    li.id = `item-${item.id}`;
                    
                    li.innerHTML = `
                        <div class="border border-transparent bg-transparent hover:bg-[#111411] hover:border-maker-border rounded-lg p-3 transition-all duration-200 flex items-center justify-between pointer-events-none group-[.active]:bg-[#111411] group-[.active]:border-maker-green group-[.active]:shadow-[0_0_10px_rgba(128,232,147,0.1)]">
                            <div class="flex items-center gap-4">
                                <div class="w-12 text-center text-xs font-bold text-gray-500 group-[.active]:text-maker-green">${item.date}</div>
                                <div>
                                    <h3 class="text-white font-semibold text-sm">${item.title}</h3>
                                    <p class="text-xs text-gray-500">${item.template}</p>
                                </div>
                            </div>
                            <div class="text-[10px] uppercase font-bold text-gray-600 bg-maker-dark px-2 py-1 rounded group-[.active]:text-maker-dark group-[.active]:bg-maker-green">${item.format.split(' ')[0]}</div>
                        </div>
                    `;
                    
                    li.addEventListener('click', () => handleItemClick(item));
                    list.appendChild(li);
                });

                container.appendChild(list);
            });

            // Trigger click on first item on load
            if (campaignData[0].items.length > 0) {
                handleItemClick(campaignData[0].items[0]);
            }
        }

        function handleItemClick(item) {
            // Remove active state
            if (currentlyActiveId) {
                const prev = document.getElementById(`item-${currentlyActiveId}`);
                if (prev) prev.classList.remove('active');
            }

            // Set new active state
            const current = document.getElementById(`item-${item.id}`);
            if (current) current.classList.add('active');
            currentlyActiveId = item.id;

            // Render Right Pane Content
            renderPreview(item);
        }

        function renderPreview(item) {
            const previewContainer = document.getElementById('preview-render');
            const briefContainer = document.getElementById('brief-render');
            
            // Fade effect
            previewContainer.style.opacity = '0';
            briefContainer.style.opacity = '0';
            
            setTimeout(() => {
                // Generate Wireframe
                if(wireframes[item.template]) {
                    previewContainer.innerHTML = wireframes[item.template]();
                } else {
                    previewContainer.innerHTML = `<div class="text-gray-500">Wireframe not found.</div>`;
                }

                // Generate Brief Text
                briefContainer.innerHTML = `
                    <div class="flex justify-between items-center mb-3">
                        <h4 class="text-maker-green font-bold text-sm tracking-wide">DESIGN BRIEF</h4>
                        <span class="text-xs bg-[#1A1D1A] px-2 py-1 rounded text-gray-300 font-medium">${item.format}</span>
                    </div>
                    <h5 class="text-white font-bold text-lg mb-1">${item.title}</h5>
                    <p class="text-sm font-medium text-gray-400 mb-3 border-b border-[#2A302A] pb-3">Menggunakan: <span class="text-white">${item.template}</span></p>
                    <div class="text-sm text-gray-300 leading-relaxed">
                        <strong class="text-white">Catatan Desain:</strong><br>
                        ${item.desc}
                    </div>
                `;

                previewContainer.style.opacity = '1';
                briefContainer.style.opacity = '1';
            }, 150);
        }

        // Initialize when DOM is ready
        window.onload = initDashboard;
    </script>
</body>
</html>
